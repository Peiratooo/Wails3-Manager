<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="wails_manager.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Peirato\Wails3 Manager">
    </Installer>
    <PackageInformation
        PackageName="com.peirato.wails3manager"
        PackageDisplayName="Wails3 Manager"
        PublisherName="CN=Peirato"
        PublisherDisplayName="Peirato"
        Version="0.1.0.0"
        PackageDescription="Desktop manager for Wails 3 projects">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.peirato.wails3manager"
                Description="Desktop manager for Wails 3 projects"
                DisplayName="Wails3 Manager"
                ExecutableName="wails_manager.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Wails3 Manager</DisplayName>
            <PublisherDisplayName>Peirato</PublisherDisplayName>
            <Description>Desktop manager for Wails 3 projects</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="wails_manager.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
